{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "radefy-techmart-activation",
  "main": "worker.mjs",
  "account_id": "2be903b56be70838b8da700bfd6ba7d9",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "radefy-techmart-activation",
      "database_id": "bc7354a8-2d68-4ab9-9c34-3b2af10c9110",
    },
  ],
  "ratelimits": [
    {
      "name": "ACTIVATION_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true },
    "redact_query_string": true,
  },
}
