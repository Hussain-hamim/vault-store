{
  "name": "radefy-techmart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Offline electronics store inventory and accounting",
  "author": "Radefy Systems",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1 --port 4173",
    "desktop": "electron .",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/prepare-sites-build.mjs",
    "test": "node --test tests/store.test.mjs tests/preload.test.mjs tests/printing.test.mjs tests/reports.test.mjs tests/brand.test.mjs tests/product-photos.test.mjs tests/appearance.test.mjs tests/licensing.test.mjs tests/licensing-credentials.test.mjs tests/database-worker.test.mjs tests/recovery.test.mjs tests/accounts.test.cjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "package:mac": "npm run license:check && npm run build && electron-builder --mac --dir && node scripts/check-packaged.mjs darwin",
    "package:win": "npm run license:check && npm run build && electron-builder --win nsis && node scripts/check-packaged.mjs win32",
    "backup": "node server/backup-cli.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "package:mac:dmg": "npm run license:check && npm run build && electron-builder --mac dmg && node scripts/check-packaged.mjs darwin",
    "test:print": "node --test tests/printing.test.mjs",
    "test:print:desktop": "electron tests/print-electron-smoke.cjs",
    "build:icons": "node scripts/build-brand-icons.mjs",
    "test:brand:desktop": "electron tests/brand-ui-smoke.cjs",
    "test:photos:desktop": "electron tests/product-photos-ui-smoke.cjs",
    "test:responsive:desktop": "electron tests/responsive-electron-smoke.cjs",
    "license:keys": "node scripts/licensing/keys.mjs",
    "license:check": "node scripts/licensing/check.mjs",
    "test:activation": "node --test tests/licensing.test.mjs tests/licensing-credentials.test.mjs",
    "test:activation:desktop": "electron tests/activation-electron-smoke.cjs && electron tests/activation-electron-smoke.cjs --legacy",
    "license:recovery": "node scripts/licensing/recovery.mjs",
    "test:recovery:live": "node scripts/licensing/recovery-live.mjs",
    "test:recovery:desktop": "electron tests/recovery-electron-smoke.cjs",
    "test:accounts:desktop": "electron tests/accounts-electron-smoke.cjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "flag-icons": "^7.6.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "44.9.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "6.4.2"
  },
  "build": {
    "appId": "com.vault.store",
    "productName": "Radefy TechMart",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/client/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json",
      "node_modules/zod/**/*",
      "shared/**/*",
      "build/icon.png"
    ],
    "asarUnpack": [
      "server/**/*",
      "node_modules/zod/**/*",
      "shared/**/*"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "icon": "build/icon.icns",
      "timestamp": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "icon": "build/icon.png"
  }
}
